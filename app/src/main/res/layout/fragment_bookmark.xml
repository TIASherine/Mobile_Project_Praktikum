<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColour"
    tools:context=".Bookmark.BookmarkFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/lightGreen"
            app:navigationIcon="@drawable/outline_arrow_back"
            app:titleTextColor="@color/blue" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupKategori"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:chipSpacingHorizontal="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSemua"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semua"
                android:textColor="@color/blue"
                app:checkedIconVisible="false"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="28dp"
                app:chipStrokeColor="@color/green"
                app:chipStrokeWidth="2dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNutrisi"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nutrisi"
                android:textColor="@color/blue"
                app:checkedIconVisible="false"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="28dp"
                app:chipStrokeColor="@color/green"
                app:chipStrokeWidth="2dp"
                app:closeIcon="@drawable/outline_close_24"
                app:closeIconVisible="false"
                app:closeIconTint="@color/blue" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKebugaran"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kebugaran"
                android:textColor="@color/blue"
                app:checkedIconVisible="false"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="28dp"
                app:chipStrokeColor="@color/green"
                app:chipStrokeWidth="2dp"
                app:closeIcon="@drawable/outline_close_24"
                app:closeIconVisible="false"
                app:closeIconTint="@color/blue" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipResep"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resep"
                android:textColor="@color/blue"
                app:checkedIconVisible="false"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="28dp"
                app:chipStrokeColor="@color/green"
                app:chipStrokeWidth="2dp"
                app:closeIcon="@drawable/outline_close_24"
                app:closeIconVisible="false"
                app:closeIconTint="@color/blue" />

        </com.google.android.material.chip.ChipGroup>

        <GridView
            android:id="@+id/gridArticleItems"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:gravity="center"
            android:horizontalSpacing="0dp"
            android:numColumns="1"
            android:paddingBottom="20dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.481"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipGroupKategori"
            app:layout_constraintVertical_bias="0.128" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
