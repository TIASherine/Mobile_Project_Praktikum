<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColour"
    tools:context=".Home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/green"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtDailyFit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="DAILYFIT"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:id="@+id/imgWelcome"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="DailyFit"
                        android:src="@drawable/fitness"
                        app:tint="@android:color/white"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/txtHeroTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sora_semibold"
                        android:text="Stay Healthy,\nFeel Happy."
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        app:layout_constraintTop_toBottomOf="@id/txtDailyFit"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/txtHeroDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="Temukan inspirasi sehat setiap hari."
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        app:layout_constraintTop_toBottomOf="@id/txtHeroTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtArticle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/sora_semibold"
                android:text="Artikel"
                android:textColor="@color/blue"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/cardWelcome"
                app:layout_constraintStart_toStartOf="parent" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHomeArticles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/txtArticle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_article"
                tools:itemCount="2" />

            <Button
                android:id="@+id/btnArticlesDetail"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:backgroundTint="@color/green"
                android:fontFamily="@font/nunito_medium"
                android:paddingEnd="30dp"
                android:text="Cek Selengkapnya"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/recyclerHomeArticles"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="25dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:rotation="-90"
                android:contentDescription="Selengkapnya"
                app:srcCompat="@drawable/arrow"
                app:tint="@color/white"
                app:layout_constraintTop_toTopOf="@id/btnArticlesDetail"
                app:layout_constraintBottom_toBottomOf="@id/btnArticlesDetail"
                app:layout_constraintEnd_toEndOf="@id/btnArticlesDetail" />

            <TextView
                android:id="@+id/txtResep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/sora_semibold"
                android:text="Resep"
                android:textColor="@color/blue"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/btnArticlesDetail"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/Artikel3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/lightGreen"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/txtResep"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@color/bgColour"
                    android:minHeight="100dp"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/imgArtikel3"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:contentDescription="Gambar resep"
                        android:src="@drawable/nutrition"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/txtJudulArtikel3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="Kenali Makanan Kamu!"
                        android:textColor="@color/blue"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imgArtikel3"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/txtDescArtikel3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="@string/descResep"
                        android:textColor="@color/blue"
                        android:textSize="12sp"
                        app:layout_constraintTop_toBottomOf="@id/txtJudulArtikel3"
                        app:layout_constraintStart_toEndOf="@id/imgArtikel3"
                        app:layout_constraintEnd_toStartOf="@id/btnArticle3Detail" />

                    <ImageView
                        android:id="@+id/btnArticle3Detail"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:rotation="180"
                        android:contentDescription="Lihat resep"
                        android:src="@drawable/outline_arrow_back"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtKebugaran"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/sora_semibold"
                android:text="Kebugaran"
                android:textColor="@color/blue"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/Artikel3"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/Artikel4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/lightGreen"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/txtKebugaran"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@color/bgColour"
                    android:minHeight="100dp"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/imgArtikel4"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:contentDescription="Gambar kebugaran"
                        android:src="@drawable/fitness"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/txtJudulArtikel4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="Tubuh Bugar Setiap Hari"
                        android:textColor="@color/blue"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imgArtikel4"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/txtDescArtikel4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="@string/descKebugaran"
                        android:textColor="@color/blue"
                        android:textSize="12sp"
                        app:layout_constraintTop_toBottomOf="@id/txtJudulArtikel4"
                        app:layout_constraintStart_toEndOf="@id/imgArtikel4"
                        app:layout_constraintEnd_toStartOf="@id/btnArticle4Detail" />

                    <ImageView
                        android:id="@+id/btnArticle4Detail"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:rotation="180"
                        android:contentDescription="Lihat kebugaran"
                        android:src="@drawable/outline_arrow_back"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
