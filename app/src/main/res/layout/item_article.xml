<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/lightGreen"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:background="@color/bgColour"
        android:padding="12dp">

        <ImageView
            android:id="@+id/articleImg"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:contentDescription="Article Image"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/articleLabels"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="6dp"
            app:chipSpacingHorizontal="4dp"
            app:layout_constraintEnd_toStartOf="@id/btnArticleBookmark"
            app:layout_constraintStart_toEndOf="@id/articleImg"
            app:layout_constraintTop_toTopOf="parent"
            app:singleLine="true" />

        <ImageView
            android:id="@+id/btnArticleBookmark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Bookmark"
            android:padding="2dp"
            android:src="@drawable/bookmark"
            app:layout_constraintBottom_toBottomOf="@id/articleLabels"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/articleLabels" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito_bold"
            android:text="Article Title"
            android:textColor="@color/blue"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/btnArticleArrow"
            app:layout_constraintStart_toEndOf="@id/articleImg"
            app:layout_constraintTop_toBottomOf="@id/articleLabels" />

        <TextView
            android:id="@+id/textDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_regular"
            android:maxLines="3"
            android:text="Article Description"
            android:textColor="@color/blue"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/btnArticleArrow"
            app:layout_constraintStart_toEndOf="@id/articleImg"
            app:layout_constraintTop_toBottomOf="@id/textTitle" />

        <ImageView
            android:id="@+id/btnArticleArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Read Article"
            android:padding="2dp"
            android:rotation="180"
            android:src="@drawable/outline_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
